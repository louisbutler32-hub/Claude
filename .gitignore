node_modules
out
.remotion
*.log

__pycache__/
*.pyc
*.wav
.audio-build
public/audio
.tts
.compile
.compile-longform

# scratch pool of downloaded photo candidates for the real-image episodes —
# only the final picked cutouts (under public/images/<episode>/) are tracked
.photo-review

# clipper: source footage, renders and intermediates stay local.
# The drop-in folders themselves are tracked (via .gitkeep) so they exist on
# a fresh clone — only what you put in them is ignored.
clipper/out/
clipper/projects/*/.work/
clipper/projects/*/source/*
clipper/projects/*/vo/*
clipper/projects/*/music/*
!clipper/projects/*/source/.gitkeep
!clipper/projects/*/vo/.gitkeep
!clipper/projects/*/music/.gitkeep
clipper/projects/_selftest/

__pycache__/
*.pyc

# third-party sound packs: not ours to redistribute
.sfx

# geo shorts: the NASA Blue Marble source and the tile pyramid cut from it
# are derived and a few hundred MB — rebuild with scripts/build-geo-basemap.py
.geo
public/assets/geo/tiles

# the owner's own Minecraft art for the POV Short: not ours to redistribute
public/images/pov-src/
public/images/pov/

# akki talks re-edits: the original renders are the input, not tracked
akki/source/*
!akki/source/.gitkeep
public/images/pov2/
public/images/chars/
public/images/chars-src/
public/images/skins/

# saga background plates: Pexels stock, rebuilt by scripts/akki-plates.py
public/plates

# real voice-over takes for the pins shorts: licensed to the channel, not the repo
.vo-takes
