    {
      "id": "kea1",
      "text": "First, the kea, a parrot from New Zealand.",
      "sfx": [
        [
          "parrot",
          2
        ]
      ]
    },
    {
      "id": "kea2",
      "text": "It rips the rubber off car windows, pulls off windshield wipers, and unzips backpacks to see what's inside.",
      "sfx": [
        [
          "rip",
          1,
          -0.75
        ],
        [
          "pop",
          7
