        [
          "pop",
          5
        ],
        [
          "pop",
          15
        ]
      ]
    },
    {
      "id": "monkey1",
      "text": "Next, the monkeys of Uluwatu Temple in Bali.",
      "sfx": [
        [
          "monkey",
          2
        ]
      ]
    },
    {
      "id": "monkey2",
      "text": "They snatch phones, glasses and hats right out of tourists' hands.",
