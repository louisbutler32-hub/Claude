        [
          "tiptoe",
          2
        ],
        [
          "kaching",
          8
        ]
      ]
    },
    {
      "id": "monkey4",
      "text": "And the more valuable the thing they took, the bigger the snack they hold out for.",
      "sfx": [
        [
          "counter",
          12
        ]
      ]
    },
    {
      "id": "koshik1",
      "text": "Then there's Koshik, an elephant at a zoo in South Korea.",
