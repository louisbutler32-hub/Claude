    {
      "id": "guide1",
      "text": "Next, the honeyguide. This bird teams up with humans to find honey.",
      "sfx": [
        [
          "chirp",
          2
        ]
      ]
    },
    {
      "id": "guide2",
      "text": "When honey hunters in Africa call out brrr-hm, it flies over and leads them straight to a wild beehive.",
