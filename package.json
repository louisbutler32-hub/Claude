{
  "name": "biggest-one-piece-bounty-jumps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render BountyVideo out/bounty-video.mp4",
    "still": "remotion still BountyVideo out/still.png",
    "map": "remotion render Map-WW2-Europe out/map-ww2-europe.mp4",
    "map:mongols": "remotion render Map-Mongols-Europe out/mongols-europe.mp4",
    "map:mansa": "remotion render Map-Mansa-Musa out/mansa-musa.mp4",
    "map:shelterbelt": "remotion render Map-Shelterbelt out/shelterbelt.mp4",
    "sfx": "node scripts/build-sfx.mjs",
    "map:data": "node scripts/build-map-data.mjs",
    "title": "remotion render Title-Kate out/kate-title.mp4",
    "title:vertical": "remotion render Title-Kate-Vertical out/kate-title-vertical.mp4",
    "name:alpha": "remotion render Title-Name-Overlay out/name-alpha.webm --codec=vp8 --image-format=png --pixel-format=yuva420p",
    "name:alpha:vertical": "remotion render Title-Name-Overlay-Vertical out/name-vertical-alpha.webm --codec=vp8 --image-format=png --pixel-format=yuva420p",
    "label:alpha": "remotion render Title-Label-Overlay out/label-alpha.webm --codec=vp8 --image-format=png --pixel-format=yuva420p",
    "label:alpha:vertical": "remotion render Title-Label-Overlay-Vertical out/label-vertical-alpha.webm --codec=vp8 --image-format=png --pixel-format=yuva420p",
    "name:black": "remotion render Title-Name-Overlay out/name-black.mp4",
    "name:black:vertical": "remotion render Title-Name-Overlay-Vertical out/name-vertical-black.mp4",
    "label:black": "remotion render Title-Label-Overlay out/label-black.mp4",
    "label:black:vertical": "remotion render Title-Label-Overlay-Vertical out/label-vertical-black.mp4",
    "name:prores": "remotion render Title-Name-Overlay out/name-alpha.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "label:prores": "remotion render Title-Label-Overlay out/label-alpha.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "title:alpha": "remotion render Title-Kate-Overlay out/kate-title-alpha.webm --codec=vp8 --image-format=png --pixel-format=yuva420p",
    "title:alpha:vertical": "remotion render Title-Kate-Overlay-Vertical out/kate-title-vertical-alpha.webm --codec=vp8 --image-format=png --pixel-format=yuva420p",
    "title:prores": "remotion render Title-Kate-Overlay out/kate-title-alpha.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "title:prores:vertical": "remotion render Title-Kate-Overlay-Vertical out/kate-title-vertical-alpha.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "veggies": "remotion render VeggieVideo out/chomp-chomp-veggies.mp4",
    "veggies:still": "remotion still Veggie-ArtSheet out/veggie-artsheet.png",
    "veggies:audio": "python3 scripts/build-veggie-audio.py",
    "planets": "remotion render PlanetsVideo out/planets.mp4",
    "planets:still": "remotion still PlanetsVideo out/planets-still.png",
    "planets:thumbs": "remotion still Planets-ThumbA out/package/thumbnail-a.png && remotion still Planets-ThumbB out/package/thumbnail-b.png",
    "planets:package": "python3 scripts/make-package.py",
    "veggies:thumb": "remotion still Veggie-Thumbnail out/thumbnail-guess-the-veggie.png && remotion still Veggie-Thumbnail-Board out/thumbnail-name-all-12.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "remotion": "4.0.499",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "typescript": "5.5.4"
  }
}
