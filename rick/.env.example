# Copy this file to .env and fill in your keys.

# Required for the real brain. Without it Rick runs in demo mode (HUD works, canned replies).
ANTHROPIC_API_KEY=

# Optional: YouTube Data API v3 key (Google Cloud Console -> Enable "YouTube Data API v3" -> Credentials -> API key)
# Lets Rick pull live subscriber / view counts and recent uploads for the channels in rick.config.json
YOUTUBE_API_KEY=

# Optional: ElevenLabs for a more cinematic voice. If empty Rick uses the browser's built-in voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional overrides
# RICK_PORT=7777
# RICK_MODEL=claude-opus-5
# RICK_NO_BROWSER=1   (do not auto-open a browser window on start)
